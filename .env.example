# Copy this file to .env for local development; fill in Telegram values there.
# Existing OS environment variables take priority over .env values.
ORIGIN=LED
DESTINATION=MOW
DEPARTURE_DATE=2026-11-04
ADULTS=1
CABIN_CLASS=E
DIRECT_ONLY=true
RECHECK_DELAY_SECONDS=30
DATABASE_PATH=data/flight_monitor.sqlite3
DATABASE_URL=
# For PostgreSQL: DATABASE_URL=postgresql://user:password@host:5432/database
# Docker Compose builds DATABASE_URL from these values (use a URL-safe password).
POSTGRES_DB=flight_monitor
POSTGRES_USER=flight_monitor
POSTGRES_PASSWORD=MyStrongTempPassword123!
CHECK_INTERVAL_MINUTES=60
BROWSER_TIMEOUT_SECONDS=60
# Optional: BROWSER_CHANNEL=chrome
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_NOTIFY_EVERY_RUN=false
MAX_TELEGRAM_USERS=3
TELEGRAM_INVITE_TTL_HOURS=24
MANUAL_CHECK_COOLDOWN_SECONDS=180
CHECK_LOCK_TTL_SECONDS=600
